{
  "name": "jarvish-ai-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx src/backend/index.ts",
    "diagnose:gemini": "node scripts/diagnose-gemini.mjs",
    "wait:backend": "node scripts/wait-for-backend.mjs",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "prestart": "npm run codegen",
    "start": "concurrently -k -s first \"npm run server\" \"npm run wait:backend && npm run dev\"",
    "start:watch": "concurrently -k -s first \"npm run server\" \"npm run wait:backend && npm run dev\" \"npm run codegen:watch\"",
    "restart": "lsof -ti:3000,5173 | xargs kill -9 || true && npm start",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke:jarvish": "tsx --tsconfig tsconfig.json scripts/smoke/jarvish-smoke.ts",
    "verify": "npm run codegen && npm run lint && npm run test && npm run smoke:jarvish && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.28",
    "@langchain/langgraph": "^1.3.7",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.2",
    "@parcel/watcher": "^2.5.6",
    "@types/classnames": "^2.3.0",
    "better-sqlite3": "^12.9.0",
    "classnames": "^2.5.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2",
    "lucide-react": "^0.575.0",
    "partial-json-parser": "^1.2.2",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@graphql-codegen/typed-document-node": "^7.0.3",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-operations": "^6.0.3",
    "@graphql-codegen/typescript-resolvers": "^6.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "sass-embedded": "^1.97.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "graphql-config": {
      "minimatch": {
        "brace-expansion": "^5.0.6"
      }
    },
    "qs": "^6.15.2",
    "ws": "^8.21.0"
  }
}
